# Copia este archivo a .env (que no se sube a Git) y cambia las claves.
# ORACLE_PASSWORD: clave del administrador SYS/SYSTEM del contenedor.
ORACLE_PASSWORD=cambia_esta_clave_sys
# Usuario de la aplicación: Flyway y JPA se conectan con este usuario.
ORACLE_APP_USER=awra_app
ORACLE_APP_PASSWORD=cambia_esta_clave_app

# Secreto para firmar los JWT. Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia_por_un_secreto_de_al_menos_32_caracteres
# Administrador inicial: se crea la primera vez que arranca la aplicación.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_clave_admin

# Cloudinary: sacalas del panel de Cloudinary (Dashboard > API Keys).
# El cloud name es público (aparece en las URLs del sitio). La API key y el
# secret son credenciales: NUNCA subas sus valores reales a Git.
CLOUDINARY_CLOUD_NAME=uhe3fxzj
CLOUDINARY_API_KEY=cambia_esta_api_key
CLOUDINARY_API_SECRET=cambia_este_api_secret
