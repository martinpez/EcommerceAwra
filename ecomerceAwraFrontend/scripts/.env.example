# Credenciales de Cloudinary para subir los medios del frontend.
#
# NO subas este archivo con valores reales: la API key y el secret nunca
# deben llegar al repositorio ni al bundle del navegador.
#
# Uso:
#   set -a && . ./.env && set +a && npm run upload:media
#
# Las mismas variables que usa el backend (ecomerceAwra/.env).

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
